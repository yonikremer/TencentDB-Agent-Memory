# ═════════════════════════════════════════════════════════════════════════====
# TDAI Global Image Local Deployment - Environment Variable Template
#
# Usage:
#   cp .env.example .env
#   # Edit .env, replace REPLACE_ME with your own values
#   ./start-all.sh
#
# Two independent parameter groups:
#   MEMORY_*   → memory + memory-hub usage (internal memory/knowledge service LLM)
#   PROXY_*    → proxy usage (upstream LLM to which user requests are forwarded)
# The two groups can be identical or point to completely different models/vendors.
# ═════════════════════════════════════════════════════════════════════════====

# ── Image tags ─────────────────────────────────────────────────────────────────
# By default, use public Docker Hub images (multi-arch amd64 + arm64, docker pull without login):
#   https://hub.docker.com/r/agentmemory/memory-core
#   https://hub.docker.com/r/agentmemory/memory-proxy
#   https://hub.docker.com/r/agentmemory/memory-hub
# To pin a specific version, replace :latest with the concrete version, e.g., :1.0.0-beta.1.
# Note: If a local image with the same name :latest already exists, the script will reuse it directly and will not automatically detect remote updates.
# To pull the latest version, run `PULL=1 ./start-all.sh`.
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── Tencent Internal Mirror (for internal staff) ────────────────────────────────────────
# In internal Tencent network (office network / devcloud), you can override to mirrors.tencent.com private registry, avoiding public Docker Hub.
# Before using, run `docker login mirrors.tencent.com`.
# MEMORY_CORE_IMAGE=mirrors.tencent.com/memory-team-control/memory-core:latest
# MEMORY_HUB_IMAGE=mirrors.tencent.com/memory-team-control/memory-hub:latest
# PROXY_IMAGE=mirrors.tencent.com/memory-team-control/proxy:latest

# ── memory group: LLM used internally by memory + memory-hub ────────────────────────────
# Purpose: memory embedding/summarizing; memory-hub knowledge wiki ingest / summarization
MEMORY_LLM_BASE_URL=REPLACE_ME              # e.g., https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME               # e.g., sk-xxxxxxxx
MEMORY_LLM_MODEL=REPLACE_ME                 # e.g., deepseek-chat
MEMORY_LLM_PROTOCOL=openai                  # openai | anthropic

# ── proxy group: proxy forwards user requests to upstream LLM ──────────────────────────────
# Purpose: coding agent / client calls proxy:8096, proxy forwards to here
PROXY_UPSTREAM_URL=REPLACE_ME               # e.g., https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME           # e.g., sk-xxxxxxxx (can differ from memory group)
PROXY_UPSTREAM_MODEL=REPLACE_ME             # e.g., deepseek-chat

# ── Ports (default work out of the box; change here if local conflicts) ───────────────────────────────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── knowledge external reachable address (required by memory-hub)─────────────────────────────────
# Allows agent / gateway to access KS tools interface. Must include /v3 prefix.
# In local scenario default to host.docker.internal for containers to loop back to host.
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

# Panel 后端 → Kernel 的转发始终走 REMOTE_INSTANCE_URL（=memory-core），不受此变量影响。
#
# 未设置时脚本会自动探测宿主机 LAN IP（`hostname -I` / macOS `ipconfig getifaddr en0`）
# 并拼成 `http://<lan-ip>:${PROXY_PORT}` —— 别人的电脑直接拷卡片里的 URL 就能连过来。
# 显式留空（=""）则回落到 gateway_endpoint 老行为。
# 想显式指定（比如公网域名 / 特定网卡 IP）就取消下面这行注释填真值：
# MEMORY_HUB_PROXY_PUBLIC_URL=http://192.168.1.100:8096

# ── 数据卷名 ─────────────────────────────────────────────────────────────────
MEMORY_CORE_VOLUME=tdai-memory-core-data
PANEL_VOLUME=tdai-panel-data

# ── memory-core 内部凭据 ─────────────────────────────────────────────────────
# Gateway 的 Bearer 层管理凭据。
#   留空（默认）   —— 关闭 Bearer gate（本地零配置体验；proxy 的 auth/sessionInit
#                    仅在此配置下能与 memory-core 直连，见 start-memory-core.sh 顶部注释）
#   非空          —— 所有请求必须带 `Authorization: Bearer <key>`；proxy 目前
#                    不发这个 header，因此 proxy 的 auth/sessionInit 会失败
# 生产环境后续需在 proxy 侧修复后再启用非空 key。
MEMORY_CORE_GATEWAY_API_KEY=

# admin 用户名（首次 init-admin 用）。user_key 由脚本首次启动自动生成一把随机 sk-mem-
# 存到 ./.admin-key —— 后续脚本 / claude-proxy 从此文件读取，不再需要手工填写。
MEMORY_CORE_ADMIN_USERNAME=admin
