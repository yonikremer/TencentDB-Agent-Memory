{
  "version": "1",
  "modules": [
    {
      "module": "quota",
      "description": "Instance-level quota parameters",
      "params": [
        {
          "param_name": "max_users_per_instance",
          "param_value": "500",
          "description": "Max users per instance",
          "allowed_scopes": ["global"]
        },
        {
          "param_name": "max_teams_per_instance",
          "param_value": "100",
          "description": "Max teams per instance",
          "allowed_scopes": ["global"]
        }
      ]
    },
    {
      "module": "asset_type",
      "description": "AssetType resource usage switch",
      "params": [
        {
          "param_name": "skill.enabled",
          "param_value": "1",
          "description": "Whether to allow using Skill assets",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "llm_wiki.enabled",
          "param_value": "1",
          "description": "Whether to allow using LLM Wiki assets",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "code_graph.enabled",
          "param_value": "1",
          "description": "Whether to allow using Code Graph assets",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "chat_memory.enabled",
          "param_value": "1",
          "description": "Whether to allow using Chat Memory assets",
          "allowed_scopes": ["global", "user"]
        }
      ]
    }
  ]
}
