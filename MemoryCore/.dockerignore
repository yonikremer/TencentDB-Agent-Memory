# Sensitive configs (exclude from image; provide via env injection or volume mounts in production)
# Root-level YAML files like tdai-gateway.yaml may contain real values for Langfuse/VDB/API_KEY.
# Even with empty string fallbacks, they should not be shipped with the image; production uses K8s Secrets + env templates.
tdai-gateway.yaml
tdai-gateway.*.yaml
.env
.env.*
**/.env
**/.env.*

# Internal CI/git metadata
.gitmodules
.coding-ci.yaml
.gitlab-ci.yml

# src/integrations is a private submodule mount point. On open-source branches this directory is empty.
# Internal builds include Redis, COS, Shark, and observability backends. Previously Dockerignore blocked the whole directory,
# causing internal deployment with state_backend=redis to fail on startup (Cannot find module '/app/src/integrations/redis/index.js').
# Now allowed: open-source builds copy an empty directory harmlessly, while internal builds load backends correctly.

# End-to-end / stress / smoke test scripts are not required at runtime and may contain debugging SSH host or internal IP references
scripts/e2e-*
scripts/verify-*
scripts/warm-*
scripts/stress-*
scripts/inspect-*
scripts/smoke-*
scripts/start-offload-*
scripts/check_sts_*
scripts/mock-shark-*
scripts/bench-*
scripts/soak-*
# Keep necessary md files (excluded by *.md above, but README.md etc. have no impact on execution, no need to keep)
# If you need to read README.md inside the container, delete the *.md line above
