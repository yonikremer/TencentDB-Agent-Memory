# Dependencies and build artifacts
node_modules
dist

# Directories excluded from the image
dashboard
gateway
docs
logs

# Runtime artifacts
*.log
*.jsonl
nohup.out
context-proxy.pid

# Config files (mounted to /data/config.yaml at runtime)
config.yaml
config-a.yaml
config-example.yaml
config.yaml.bak.*
config.*.local.yaml
**/.env
**/.env.*

# Version control and editor files
.git
.gitignore
.gitmodules
.vscode
.idea
.codebuddy
.claude

# Internal CI / internal build tools (packing these into the image would expose internal topology)
.coding-ci.yaml

# E2E / verify / smoke scripts —— not needed in the runtime image
scripts/e2e-*
scripts/verify-*
scripts/warm-*
scripts/inspect-*
scripts/smoke-*
scripts/mock-shark-*
e2e/

# The container's own files
Dockerfile
.dockerignore
