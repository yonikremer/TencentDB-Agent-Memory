# Knowledge Service Configuration
# Usage: cp .env.example .env && edit .env
# .env is automatically loaded by `import 'dotenv/config'` at the start of src/config.ts

# ═══ HTTP Server ═══
PORT=8421
API_PREFIX=/v3
LOG_LEVEL=debug

# ═══ Data Storage ═══
# Root directory for data: stores git clones, wiki assets, BM25 index, and SQLite files
KNOWLEDGE_DATA_DIR=./data
# SQLite database file (contains tables: knowledge_wiki, knowledge_code_graph, and audit tables)
KNOWLEDGE_DB_PATH=./data/knowledge.db

# ═══ LLM Configuration (required for wiki ingestion, not for code graph) ═══
# LLM_MODE: Global default routing (per‑instance llm_binding always overrides this)
#   proxy (default): Use the cloud Proxy, billed via the knowledge‑service key pushed by TMC.
#                  KS does not need to start a Proxy locally; if no binding is present, an error is thrown.
#   custom       : Connect directly to a user‑provided endpoint using LLM_BASE_URL and LLM_API_KEY below.
LLM_MODE=proxy
LLM_PROVIDER=custom
LLM_MODEL=Memory-Model
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=1200000

# Required only when LLM_MODE=custom; provide LLM credentials via environment variables.
LLM_BASE_URL=

# ═══ MCP Server (used by src/mcp/server.ts) ═══
# MCP server forwards HTTP requests to this service; set the target URL here
KNOWLEDGE_API_URL=http://localhost:8421
# KNOWLEDGE_API_TOKEN=optional-bearer-token

# ═══ Control Integration (team‑memory‑control) ═══
# When deploying TMC + KS, configure these two values explicitly (defaults are empty in code):
# - PUBLIC_BASE_URL: address reachable by the Agent that includes the /v3 prefix
# - CALLBACK_URL: base address of the TMC; /api/v1/knowledge/status-callback is appended automatically
# For Docker deployments, use the CLI flags --public-url and --tmc-callback (see docs/deployment.md)
KNOWLEDGE_PUBLIC_BASE_URL=http://localhost:8421/v3
TMC_CALLBACK_URL=http://localhost:8123

# Configuration used only by the Control side (not read by this service):
#   KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8421

# ═══ Wiki Ingest Concurrency (optional) ═══
# Max concurrent LLM extractions in stage 1 per wiki (default 3, range 1‑10)
# KNOWLEDGE_WIKI_INGEST_CONCURRENCY=3
# Global max concurrency for LLM extractions + merges across all wikis (default 5, range 1‑20)
# KNOWLEDGE_LLM_GLOBAL_CONCURRENCY=5

# ═══ Retrieval‑Augmented Wiki Ingestion (optional, enabled by default) ═══
# Inject relevant existing wiki page bodies into the extraction prompt so that sources that depend on prior docs receive real context
# (instead of a simple per‑page metadata catalog). Retrieval reuses the existing BM25 + graph search and readPage logic.
# Toggle: enabled by default; set to false to disable
# KNOWLEDGE_WIKI_RETRIEVAL_ENABLED=true
# Maximum number of existing pages to inject (default 3, range 1‑10)
# KNOWLEDGE_WIKI_RETRIEVAL_TOP_K=3
# Total character budget for injected context, including block headers (default 12000, range 1000‑60000)
# KNOWLEDGE_WIKI_RETRIEVAL_MAX_CHARS=12000
# Upper limit on source words used when building the search query (default 24, range 4‑100)
# KNOWLEDGE_WIKI_RETRIEVAL_QUERY_TERMS=24

# ═══ ClickHouse Tool‑Call Telemetry (optional, disabled by default) ═══
# Captures POST /v3/tools/call requests and writes them to the tool_call_logs table (compatible with Memory/Skill schema)
# Request bodies are recursively sanitized and truncated to 512 bytes; write failures do not affect Knowledge service requests
KNOWLEDGE_CLICKHOUSE_ENABLED=false
KNOWLEDGE_CLICKHOUSE_URL=http://127.0.0.1:8123
KNOWLEDGE_CLICKHOUSE_DATABASE=default
KNOWLEDGE_CLICKHOUSE_TABLE=tool_call_logs
KNOWLEDGE_CLICKHOUSE_USER=default
# When authentication is required, provide the ClickHouse password via environment variable
KNOWLEDGE_CLICKHOUSE_FLUSH_INTERVAL_MS=5000
KNOWLEDGE_CLICKHOUSE_FLUSH_THRESHOLD=50
KNOWLEDGE_CLICKHOUSE_TTL_DAYS=90
KNOWLEDGE_CLICKHOUSE_REQUEST_TIMEOUT_MS=5000

# ═══ Code‑Graph Scheduled Auto‑Sync ═══
# Periodically scans all ready‑state code‑graphs; a FIFO queue with a worker pool pulls the latest Git commits and rebuilds the index
# Disabled by default; when enabled, the sync frequency for a single repo is max(single sync duration, scan interval)
# Telemetry endpoints: GET /v3/auto-sync/status | POST /v3/auto-sync/trigger
KNOWLEDGE_AUTO_SYNC_ENABLED=false
# Scan interval in minutes (range 1‑60)
KNOWLEDGE_AUTO_SYNC_SCAN_INTERVAL_MIN=10
# Max number of concurrent workers syncing repos (range 1‑20)
KNOWLEDGE_AUTO_SYNC_MAX_CONCURRENT=3
