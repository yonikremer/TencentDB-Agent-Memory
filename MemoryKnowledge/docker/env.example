# team-knowledge — docker compose environment variables
# usage:
#   cp docker/env.example docker/env.docker
#   edit docker/env.docker
#   docker compose --env-file docker/env.docker up -d --build
#   ./docker/smoke-test.sh --base-url http://127.0.0.1:8421

# Pushed CSIG Hub can be specified (otherwise the local build)
# TEAM_KNOWLEDGE_IMAGE=csighub.tencentyun.com/<namespace>/team-knowledge:0.1.0

TEAM_KNOWLEDGE_HOST_PORT=8421

# ── Required: cloud Agent Access address (including /v3), do not use Docker Service name ──
PUBLIC_URL=http://203.0.113.10:8421/v3

# ── suggestion:TMC root address (team-knowledge callback, excluding /api/... path)──
TMC_CALLBACK=http://203.0.113.10:8123

# TMC Side configuration (not in this file): KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8421  (excluding /v3)

# ── Wiki extract LLM routing ──
# LLM_MODE=proxy(default): go context_proxy(TMC Pushed llm_binding), no need for the following Key.
# LLM_MODE=custom       : Direct connection comes with its own endpoint, which needs to be filled in LLM_API_KEY / LLM_BASE_URL.
LLM_MODE=proxy
LLM_MODEL=ep-your-endpoint-id
# only LLM_MODE=custom When filling in:
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1

# ── Wiki ingest concurrent (Optional) ──
# KNOWLEDGE_WIKI_INGEST_CONCURRENCY=3           # one wiki inner stage1 concurrent,1~10
# KNOWLEDGE_LLM_GLOBAL_CONCURRENCY=5            # overall situation LLM concurrent,1~20

# ── ClickHouse Tool call buried points (Optional, Off by default) ──
KNOWLEDGE_CLICKHOUSE_ENABLED=false
# KNOWLEDGE_CLICKHOUSE_URL=http://clickhouse:8123
# KNOWLEDGE_CLICKHOUSE_DATABASE=default
# KNOWLEDGE_CLICKHOUSE_TABLE=tool_call_logs
# KNOWLEDGE_CLICKHOUSE_USER=default
# When enabling authentication, please inject it into the running environment ClickHouse password.
# KNOWLEDGE_CLICKHOUSE_FLUSH_INTERVAL_MS=5000
# KNOWLEDGE_CLICKHOUSE_FLUSH_THRESHOLD=50
# KNOWLEDGE_CLICKHOUSE_TTL_DAYS=90
# KNOWLEDGE_CLICKHOUSE_REQUEST_TIMEOUT_MS=5000

# ── Code-Graph Scheduled automatic synchronization (Optional, Off by default) ──
# After opening every SCAN_INTERVAL_MIN Scan all once every minute ready of code-graph, pass FIFO
# queue + worker pool pull git Latest code and rebuild index. same id No duplication.
# observation: GET /v3/auto-sync/status | manual trigger: POST /v3/auto-sync/trigger
# KNOWLEDGE_AUTO_SYNC_ENABLED=true
# KNOWLEDGE_AUTO_SYNC_SCAN_INTERVAL_MIN=10      # 1~60
# KNOWLEDGE_AUTO_SYNC_MAX_CONCURRENT=3          # 1~20
