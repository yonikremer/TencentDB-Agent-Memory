# Dockerfile.local specific ignore list (BuildKit: <dockerfile>.dockerignore takes precedence over root .dockerignore)
# Purpose: reduce the build context and avoid copying host artifacts into the image
#   —— especially node_modules (better-sqlite3 native binaries are compiled for the host platform, and entering the image will crash,
#       as the image will re-run npm install to recompile), as well as data/ (containing real user SQLite data).

# Dependencies (Reinstall inside the image)
**/node_modules
.pnpm-store/

# Build artifacts (rebuilt inside the image)
**/dist
**/build
**/*.js.map
**/*.tsbuildinfo
frontend/src/**/*.js
frontend/src/**/*.js.map

# Environment and local data (prohibited from being included in the image)
# ⚠️ config/*.json contains real kernel api_key (bearer token), must be injected via runtime mounting or
#    K8s Secret, must not be included in the image. Runtime mapping example:
#      -v /path/to/metadata-instances.json:/app/config/metadata-instances.json:ro
.env
.env.*
config/*.json
config/*.yaml
config/*.yml
data/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite

# Log / Coverage / e2e Output
**/logs
**/*.log
coverage/
frontend/test-results/
frontend/playwright-report/

# Version Control and Tool Metadata
.git
.gitignore
.idea/
.vscode/
.iwiki
.codebuddy

# OS / Editor Misc
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Temporary directory
tmp/
.tmp/

# Documentation is not included in execution (optional, further slimming the context)
docs/

# Test scripts are not part of runtime (hardcoded internal path `/root/git.woa.com/cloud_nosql/tdai` in shell,
# leaking internal GitLab domain and deployment habits when included in the image)
tests/
**/*.e2e.sh
e2e-*.sh
