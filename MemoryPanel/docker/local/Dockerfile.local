# syntax=docker/dockerfile:1
# ──────────────────────────────────────────────────────────────────────
# team-memory-control — Local Deployment Mode Image (Panel Control HTTP :8123)
#
# Features (local mode):
#   - Run src/index.ts directly with tsx (stateless panel, entry src/panel/);
#   - Install all dependencies; native dependency better-sqlite3 requires python3/make/g++ compilation;
#   - web/ frontend is built in an independent stage, and the artifacts are statically hosted by UI_DIST_DIR.
#
# Note: The build context is the repository root (the image will package the current working tree).
#
# Build:
#   docker build --build-arg PANEL_UI=web -t team-memory-control:local \
#     -f docker/local/Dockerfile.local .
# Run:
#   docker run -d -p 8123:8123 \
#     -e UI_DIST_DIR=./web/dist \
#     -e METADATA_INSTANCES_CONFIG=/app/config/metadata-instances.json \
#     team-memory-control:local
# ──────────────────────────────────────────────────────────────────────
ARG PANEL_UI=web

# ── base: node:22-slim + Tencent Cloud apt mirror + native build toolchain ──────────────
FROM node:22-slim AS base

RUN sed -i 's|deb.debian.org|mirrors.tencent.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.tencent.com|g' /etc/apt/sources.list 2>/dev/null || true

# better-sqlite3 native compilation + git (optional) + curl (healthcheck)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── ui-builder: only build the selected panels (web or frontend) → /ui/dist ────────
# WEB_UI=1 (default): build panel UI normally.
# WEB_UI=0: skip panel UI build, generate placeholder dist. Panel UI depends on @tencent/* internal packages,
#    which are not available in the public npm mirror; use it to bypass when offline or without internal sources. The control backend, /health, and /api/
#    are unaffected, only the static panels are unavailable (see src/panel/http/app.ts: /api, /health prioritize returning).
FROM base AS ui-builder
ARG PANEL_UI
ARG WEB_UI=1
COPY ${PANEL_UI}/ /ui/
WORKDIR /ui
RUN --mount=type=cache,id=npm-tmc-ui,target=/root/.npm \
    if [ "$WEB_UI" = "0" ]; then \
      echo "[ui-builder] WEB_UI=0 → Skip panel UI build, generate placeholder dist"; \
      mkdir -p /ui/dist && \
      printf '<!doctype html><meta charset="utf-8"><title>panel disabled</title><body>Control panel UI is disabled in this image (WEB_UI=0).</body>' > /ui/dist/index.html; \
    else \
      npm install --no-audit --no-fund && npm run build; \
    fi

# ── runtime: control backend (tsx directly runs src/index.ts) ────────────────────
FROM base AS runtime
ARG PANEL_UI

# Whole warehouse COPY, then install (native better-sqlite3 is compiled in this image)
COPY . .
RUN --mount=type=cache,id=npm-tmc,target=/root/.npm \
    npm install --no-audit --no-fund

# Place the selected panel artifacts into the Panel static hosting directory
COPY --from=ui-builder /ui/dist ./${PANEL_UI}/dist
ENV UI_DIST_DIR=./${PANEL_UI}/dist

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8123
RUN mkdir -p /app/logs /data
EXPOSE 8123

HEALTHCHECK --interval=15s --timeout=10s --retries=20 --start-period=60s \
  CMD curl -fsS http://127.0.0.1:8123/health || exit 1

# control directly runs source code with tsx (stateless panel, entry src/panel/)
CMD ["node", "--import", "tsx/esm", "src/index.ts"]
