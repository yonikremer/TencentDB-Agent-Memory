# ═══════════════════════════════════════════════════════════
# Control Panel Environment Variable Template
# Architecture: Link A (stateless panel) — entry src/index.ts directly goes to src/panel/
# Copy to .env and modify as needed
#
# Design Document: docs/architecture/09-new-panel-control-backend-design.md
# API Contract: docs/api/meta-api.openapi.yaml
# E2E Test: docs/architecture/10-panel-control-e2e-test-plan.md
# Deploy Smoke: docs/architecture/11-smoke-meta-post-deploy.md
# ═══════════════════════════════════════════════════════════

# ── Service ──
HOST=0.0.0.0
PORT=8123

# ── Instance Registry (JSON file path) ──
# Each field: id, name, gateway_endpoint, api_key (Gateway Bearer)
# First local startup: copy from template then fill in (this file is gitignored, do not commit)
#   cp config/metadata-instances.example.json config/metadata-instances.json
# Field Description: config/metadata-instances.README.md
METADATA_INSTANCES_CONFIG=./config/metadata-instances.json
METADATA_REMOTE_TIMEOUT_MS=15000

# ── Logs ──
# LOG_LEVEL: debug | info | warn | error
# LOG_FORMAT: pretty (local development) | json (online collection)
LOG_LEVEL=info
LOG_FORMAT=pretty

# ── Frontend Static Resources (Same-origin Hosting by Backend in Production Mode) ──
UI_DIST_DIR=./web/dist

# ── Knowledge Service (Wiki / Code-Graph Standalone Service :8421) ──
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8421
KNOWLEDGE_AUTH_TOKEN=
KNOWLEDGE_TIMEOUT_MS=30000

# ==== Knowledge Service LLM Binding (Synchronized at Startup) ====
# At startup, ensure the knowledge-service LLM binding exists for each instance in the registry towards KS
# (KS /v3/internal/llm-binding/*): use the instance api_key as admin identity to locate/create
# the hidden knowledge-service user, mint user_key, and push to KS. Best-effort; on failure,
# only log and do not block startup. Design see 09-new-panel-control-backend-design.md §4.2
KNOWLEDGE_LLM_BINDING_SYNC=true
# KS LLM binding uses the context proxy entry (mode=proxy)
KNOWLEDGE_LLM_PROXY_BASE_URL=http://127.0.0.1:8096
# Note: model is not configured here, and is uniformly determined by KS's LLM_MODEL (default Memory-Model)

# ── Integration ──
# Gateway：http://127.0.0.1:8420
# Panel E2E：./tests/panel/e2e-panel-meta.sh
