# ============================================================
# Web Frontend Environment Variable Description
# ============================================================
# Copy this file to .env and modify the values:
#    cp .env.example .env
#
# Takes effect after restarting the dev server (Vite does not hot-reload environment variables).

# ─── Control Backend Address (vite proxy) ─────────────────────────
# Default: http://127.0.0.1:8123 (see web/vite.config.ts)
# VITE_TMC_BACKEND_URL=http://127.0.0.1:8123

# ─── Memory Gateway (Optional, /v3 Proxy) ─────────────────────────
# VITE_SKILL_GATEWAY_URL=http://127.0.0.1:8420
